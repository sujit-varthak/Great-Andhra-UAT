NODE_ENV=development
PORT=4000

# connection_limit caps how many DB connections this one backend instance's
# Prisma Client can open at once. Without it, Prisma defaults to
# num_physical_cpus*2+1 per instance - fine on a single dev machine, but
# unbounded per-instance pools plus the homepage's still-N+1-shaped relation
# fetching (see articles.service.ts's articleInclude) can add up fast across
# instances against a shared managed Postgres connection cap. 10 is a
# reasonable starting point for this app's current scale (small, few
# instances) - raise it if Postgres logs show connections being queued.
DATABASE_URL="postgresql://greatandhra:greatandhra_dev_password@localhost:5432/greatandhra_cms?schema=public&connection_limit=10"

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_PREAUTH_SECRET=change-me-preauth-secret

ADMIN_ORIGIN=http://localhost:3000

# Local dev: MinIO. Production: Cloudflare R2 (S3-compatible) - see values below.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=greatandhra-media
S3_ACCESS_KEY=greatandhra
S3_SECRET_KEY=greatandhra_dev_password
# Public URL prefix the browser will load images from. With MinIO's default
# path-style routing and a public-read bucket policy, this is:
S3_PUBLIC_URL_BASE=http://localhost:9000/greatandhra-media

# Cloudflare R2 production values (fill in ACCESS_KEY/SECRET_KEY yourself from
# Cloudflare dashboard -> R2 -> Manage API Tokens, then use this block in place
# of the MinIO block above - same variable names):
#   S3_ENDPOINT=https://2147b71d6eff3027bdc477dc946e8728.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=gaassets
#   S3_ACCESS_KEY=<R2 API token access key id - fill in>
#   S3_SECRET_KEY=<R2 API token secret access key - fill in>
#   S3_PUBLIC_URL_BASE=https://pub-9cc7010a309945d085e556ec87037195.r2.dev
#   (double-check this in the Cloudflare dashboard - R2 -> your bucket ->
#   Settings -> "Public R2.dev Bucket URL" - it should be exactly one
#   https://pub-....r2.dev, not that string repeated twice)
#
# Vercel Blob is retired as of the R2 migration - MediaModule now wires
# S3Service instead of VercelBlobService (see backend/scripts/migrate-images-to-r2.ts
# for the one-time backfill of pre-existing Vercel Blob URLs already in the DB).
# BLOB_READ_WRITE_TOKEN=change-me-vercel-blob-token

SEED_ADMIN_EMAIL=admin@greatandhra.com
