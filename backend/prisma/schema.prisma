// GreatAndhra Admin CMS — data model
// Maps the recovered legacy MySQL schema (news, newscategory, chkum, flashnews,
// trending, epaperimg, schema_data, tags/tags1, news_tags/news_tags1) onto a
// normalized PostgreSQL schema, per proposal §4 (Data Migration Plan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  MODERATOR
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Replaces `chkum`. No legacy passwords are ever imported (proposal §3.3/§4) —
// every account here is created via invite and sets its own Argon2id password.
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String?
  role              Role      @default(AUTHOR)
  status            UserStatus @default(INVITED)
  inviteToken       String?   @unique
  inviteExpiresAt   DateTime?

  totpSecret        String?
  totpEnabled       Boolean   @default(false)

  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  articles          Article[]
  auditLogs         AuditLog[]
  advertisements    Advertisement[] @relation("advertisement_creator")

  @@map("users")
}

// Rotating refresh tokens — only the hash is stored, rotated on every use.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Replaces `newscategory`. Self-referential for subcategories.
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToSubcategory")
  articles  Article[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

// Replaces tags/tags1 (de-duplicated).
model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  slug      String        @unique
  articles  ArticleTag[]

  createdAt DateTime      @default(now())

  @@map("tags")
}

// Replaces news_tags/news_tags1 (de-duplicated join table).
model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// Replaces `news`. schemaData carries the old `schema_data` movie/review
// fields as a flexible JSON blob rather than a rigid separate table.
model Article {
  id                String        @id @default(uuid())
  shortId           Int           @unique @default(autoincrement())
  title             String
  slug              String        @unique
  body              String
  excerpt           String?

  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags              ArticleTag[]

  authorId          String
  author            User          @relation(fields: [authorId], references: [id])

  publisherName     String?
  featuredImageUrl  String?

  seoTitle          String?
  seoDescription    String?

  isHot             Boolean       @default(false)
  isTrending        Boolean       @default(false)
  isTopFive         Boolean       @default(false)
  isMobileVisible   Boolean       @default(true)
  isBigStory        Boolean       @default(false)
  isTalkOfTheTown   Boolean       @default(false)
  isFeatured        Boolean       @default(false)

  // Original WordPress wp:post_id, set only on imported articles - lets a
  // re-uploaded XML file skip posts already imported instead of duplicating.
  legacyPostId      Int?          @unique

  status            ArticleStatus @default(DRAFT)
  scheduledAt       DateTime?
  publishedAt       DateTime?

  viewCount         Int           @default(0)

  // Movie/review structured data: { movieName: string, rating: string, releaseDate: string, ... }
  // rating is free-text (e.g. "2.5/5"), not a bare number - not every rating
  // scale is out of 10.
  schemaData        Json?

  ratings           Rating[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("articles")
}

// Replaces `flashnews`.
model FlashNews {
  id        String   @id @default(uuid())
  headline  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flash_news")
}

// Replaces `trending`.
model TrendingLink {
  id        String   @id @default(uuid())
  title     String
  linkUrl   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trending_links")
}

// Curated USA movie showtime links for the homepage - not tied to Article.
model UsaMovieSchedule {
  id           String   @id @default(uuid())
  title        String
  linkUrl      String
  openInNewTab Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usa_movie_schedule")
}

// Curated "This Week Top 5" links for the homepage - not tied to Article.
model WeeklyTopFive {
  id           String   @id @default(uuid())
  title        String
  linkUrl      String
  openInNewTab Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("weekly_top_five")
}

enum MovieBoxOfficeSection {
  ALL_TIME
  USA_BOX_OFFICE
}

// Curated box-office rankings for the homepage - covers both "All Time Top
// Films" and "USA Box Office" sections, distinguished by `section`, since
// both have identical fields (movie name + link + amount).
model MovieBoxOffice {
  id           String                @id @default(uuid())
  section      MovieBoxOfficeSection
  movieName    String
  linkUrl      String
  amount       String
  openInNewTab Boolean               @default(false)
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([section])
  @@map("movie_box_office")
}

// Replaces `dontmiss`.
model DontMiss {
  id        String   @id @default(uuid())
  title     String
  linkUrl   String
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dont_miss")
}

// Replaces `epaperimg`.
model EpaperImage {
  id         String   @id @default(uuid())
  editionDate DateTime
  pageNumber Int
  imageUrl   String
  createdAt  DateTime @default(now())

  @@unique([editionDate, pageNumber])
  @@map("epaper_images")
}

model Rating {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  value       Int
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([articleId, fingerprint])
  @@map("ratings")
}

// Immutable audit trail — every create/update/delete on core entities lands
// here with actor, timestamps, and before/after values (proposal §3.3).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum AdType {
  IMAGE
  SCRIPT
}

enum AdZone {
  // Homepage
  HOMEPAGE_SIDEBAR_LEFT
  HOMEPAGE_SIDEBAR_RIGHT
  HOMEPAGE_TOP_BANNER
  HOMEPAGE_SECTION_INLINE
  HOMEPAGE_MOBILE_BANNER
  HOMEPAGE_ABOVE_HEADER_BANNER
  HOMEPAGE_STRIP_BANNER_1
  HOMEPAGE_STRIP_BANNER_2
  HOMEPAGE_STRIP_BANNER_3
  HOMEPAGE_BIG_STORY_BANNER

  // Inner Page (Article Detail)
  INNER_SIDEBAR_LEFT
  INNER_SIDEBAR_RIGHT
  INNER_TOP_BANNER
  INNER_MOBILE_BANNER

  // Box Office
  BOXOFFICE_SIDEBAR_LEFT
  BOXOFFICE_SIDEBAR_RIGHT
  BOXOFFICE_TOP_BANNER
  BOXOFFICE_MOBILE_BANNER

  // Roadblock (full-page interstitial)
  ROADBLOCK
}

model Advertisement {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(255)

  // Type & Content
  type              AdType    @default(IMAGE)

  // IMAGE fields (shown when type = IMAGE)
  imageUrlDesktop   String?   @db.Text
  imageUrlMobile    String?   @db.Text
  landingUrl        String?   @db.Text

  // SCRIPT fields (shown when type = SCRIPT)
  scriptCode        String?   @db.Text

  // Placement & Visibility
  zone              AdZone
  showOnDesktop     Boolean   @default(true)
  showOnMobile      Boolean   @default(true)

  // Roadblock-specific
  isRoadblock       Boolean   @default(false)
  roadblockDelayMs  Int       @default(15000)
  roadblockCookieTTL Int      @default(900)

  // Scheduling
  isActive          Boolean   @default(true)
  startDate         DateTime  @default(now())
  endDate           DateTime?

  // Rotation
  sortOrder         Int       @default(0)

  // Audit
  createdBy         String
  createdByUser     User?     @relation("advertisement_creator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([zone, isActive, startDate, endDate])
  @@map("advertisements")
}
